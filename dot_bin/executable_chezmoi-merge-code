# Description: chezmoi-merge-code <Destination> <Source> <Target>
dest="$1"; src="$2"; tgt="$3"
base="${tgt}.base"
cp "$tgt" "$base"
code --locale=zh-cn --new-window --wait --merge "$dest" "$tgt" "$base" "$src"
