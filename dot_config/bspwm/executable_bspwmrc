#! /bin/bash
# export XDG_DATA_DIRS="$XDG_DATA_DIRS:$HOME/.local/share/flatpak/exports/share"
source "$HOME/.xprofile"

for process in picom dunst fcitx5 sxhkd; do
    pkill -u "$UID" -x "$process" 2>/dev/null || :
    while pgrep -u "$UID" -x "$process" >/dev/null; do sleep 0.1; done
done

feh --bg-fill --randomize --no-fehbg $HOME/Sync/Wallpaper &
picom --daemon &
dunst &
fcitx5 -d -s 3 &
sxhkd &

$HOME/.config/autostart/scripts/launch-polybar &
$HOME/.config/autostart/scripts/launch-copyq &

xset s off
# xset -dpms
xset dpms 0 0 600

bspc monitor -d          

bspc config focused_border_color "#81A1C1"
bspc config normal_border_color "#2E3440"
bspc config active_border_color "#B48EAD"
bspc config presel_feedback_color "#A3BE8C"

bspc config border_width    2
bspc config window_gap      8
bspc config split_ratio     0.50


bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config single_monocle false
# bspc config focus_follows_pointer true

# xprop WM_CLASS
bspc desktop '^3' -l monocle
bspc rule -a Google-chrome desktop='^2'
bspc rule -a firefox desktop='^2'
bspc rule -a Microsoft-edge desktop='^2'
bspc rule -a Code desktop='^3'
bspc rule -a 'jlceda pro' desktop='^3'
bspc rule -a com.microsoft.vscode desktop='^3'
bspc rule -a com.microsoft.VSCode desktop='^3'
bspc rule -a jetbrains-goland desktop='^3'
bspc rule -a thunderbird-default desktop='^4'
bspc rule -a org.remmina.Remmina desktop='^5'
bspc rule -a TelegramDesktop desktop='^6' border=off
bspc rule -a wechat desktop='^6' border=off
bspc rule -a QQ desktop='^6' border=off
bspc rule -a mpv desktop='^7' follow=on
bspc rule -a vlc desktop='^7' follow=on
bspc rule -a yesplaymusic desktop='^8' follow=on
bspc rule -a Virt-manager desktop='^9' follow=on
bspc rule -a CodeSwitch state=floating
bspc rule -a Cc-switch state=floating
bspc rule -a scrcpy state=floating
bspc rule -a Viewnior state=floating
bspc rule -a copyq state=floating
bspc rule -a Thunar state=floating
bspc rule -a Ibus-ui-gtk3 state=floating
