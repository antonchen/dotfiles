export EDITOR=vim

# podman
export REGISTRY_AUTH_FILE="$HOME/.config/containers/auth.json"

# python
export PYENV_ROOT="$HOME/sdk/pyenv"
if command -v pyenv >/dev/null 2>&1; then
    case $- in
        *i*)
            if [ -n "${ZSH_VERSION-}" ]; then
                eval "$(pyenv init - zsh)"
            elif [ -n "${BASH_VERSION-}" ]; then
                eval "$(pyenv init - bash)"
            else
                eval "$(pyenv init --path)"
            fi
            ;;
        *) eval "$(pyenv init --path)" ;;
    esac
fi

# fnm
export FNM_DIR="$HOME/sdk/fnm"
export PNPM_HOME="$HOME/sdk/pnpm"
if command -v fnm >/dev/null 2>&1; then
    case $- in
        *i*)
            if [ -n "${ZSH_VERSION-}" ]; then
                eval "$(fnm env --shell zsh)"
            elif [ -n "${BASH_VERSION-}" ]; then
                eval "$(fnm env --use-on-cd --shell bash)"
            else
                eval "$(fnm env --shell bash)"
            fi
            ;;
        *) eval "$(fnm env --shell bash)" ;;
    esac
fi

# rust
export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup
export RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup
export RUSTUP_HOME="$HOME/sdk/rust/rustup"
export CARGO_HOME="$HOME/sdk/rust/cargo"

# go
export GOPATH="$HOME/sdk/go"
export GOBIN="$GOPATH/bin"

# 公共路径，重复加载时不重复添加
for _profile_path in "$HOME/.bin" "$HOME/.local/bin" "$CARGO_HOME/bin" "$GOBIN" "$PNPM_HOME/bin" "$PYENV_ROOT/bin"; do
    case ":$PATH:" in
        *":$_profile_path:"*) ;;
        *) PATH="$_profile_path:$PATH" ;;
    esac
done
export PATH
unset _profile_path
